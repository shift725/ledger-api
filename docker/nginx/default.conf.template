# Processed by nginx official image on container start:
#   /etc/nginx/templates/default.conf.template -> /etc/nginx/conf.d/default.conf
# Only ${DOMAIN_NAME} is substituted (NGINX_ENVSUBST_FILTER=DOMAIN_NAME);
# nginx runtime variables like $host, $remote_addr are left intact.

# HTTP — serve ACME challenge, redirect everything else to HTTPS
server {
    listen      80;
    listen [::]:80;
    server_name ${DOMAIN_NAME};

    # Let's Encrypt webroot challenge (certbot writes here, nginx serves it)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS — TLS termination, then reverse proxy everything to the frontend nginx.
# edge 只做一件事：解 TLS。路由（SPA vs /api vs /admin）全交給 frontend/nginx.conf 一處決定，
# 這樣 frontend image 環境無關（dev 直連、prod 躲 edge 後都是同一顆），edge 是啞的 TLS 終止器。
server {
    listen      443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    # ssl-params.conf is auto-loaded at http context by nginx.conf's
    # `include /etc/nginx/conf.d/*.conf;` — its ssl_* directives become defaults
    # for this server. No explicit include needed here.

    client_max_body_size 10m;

    # 反代目標寫成變數＋Docker 內建 DNS（127.0.0.11）：每次部署重建 frontend 會換 IP，
    # 寫死主機名的話 nginx 只在啟動解析一次、之後一直打舊 IP（同 frontend/nginx.conf 的做法）。
    # 帶變數後 proxy_pass 不自動接路徑，須明寫 $request_uri。
    resolver 127.0.0.11 valid=10s;
    set $upstream http://frontend:80;

    location / {
        proxy_pass         $upstream$request_uri;
        proxy_http_version 1.1;
        # 此 server 聽 443 ssl → $scheme 恆為 https：edge 是第一跳，由它權威地斷言原始協定。
        # $http_host 保留 port，讓 DRF 分頁的絕對連結指得回瀏覽器實際位址。
        proxy_set_header   Host              $http_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
